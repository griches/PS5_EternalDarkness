-#if defined(SDL_PLATFORM_ANDROID)
+#if defined(__PROSPERO__)
+  // PlayStation 5: one output and no window. Dawn's PS5 port (ps5/patches/dawn.patch)
+  // takes the Android native-window descriptor for it (VK_KHR_display underneath);
